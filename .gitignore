# pubspec.lock is intentionally not committed here: audioplayers was added
# after the original lock was generated, so the committed lock was stale
# and would have blocked `flutter pub get`. Let pub resolve fresh.
pubspec.lock

# LICENSE SIGNING KEYS — NEVER COMMIT OR DISTRIBUTE.
#
# The production private key deliberately lives OUTSIDE this repository
# (~/.pokerledger/signing/), so nothing here should ever match. These
# rules are defence in depth: if a key is ever copied into the tree by
# mistake, git refuses to stage it.
#
# Only the PUBLIC modulus — embedded in lib/license/license_keys.dart —
# is safe to ship.
*.pem
*.key
*.p8
*.pkcs12
*.pfx
tool/license_keys/
**/*private_key*
**/*signing_key*

# Local owner backup and artifacts
OWNER_LICENSE_BACKUP.txt
.artifacts/
.gradle_home.FullName/
.gradle_release/
.android_release/
temp_gradle/
temp_android/
android/.gradle_local/

