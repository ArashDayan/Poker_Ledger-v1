<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- App Lock. USE_BIOMETRIC lets the OS show its own biometric
         prompt; it does NOT grant this app access to fingerprint or face
         data, which never leaves the secure hardware. The app only ever
         receives a yes/no answer from the operating system. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- share_plus needs no permission for sharing files via FileProvider.
         file_picker reads user-chosen files through the system picker, so
         no broad storage permission is required on modern Android.
         The app is offline-first and deliberately requests nothing else. -->

    <application
        android:label="Poker Ledger"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:requestLegacyExternalStorage="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- Shows the branded launch background until Flutter's first
                 frame is drawn, so the app never flashes white. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <!-- Required so share_plus can resolve apps that accept text/files. -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>
